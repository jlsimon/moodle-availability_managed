{{!
    @template availability_managed/dashboard

    Central dashboard for managed availability.

    Example context (json):
    {
        "courseid": 2,
        "sesskey": "example",
        "sections": []
    }
}}
<div class="local-managedavailability" data-region="managed-dashboard">
    <div class="card mb-3">
        <div class="card-body">
            <ul class="nav nav-tabs mb-3" role="tablist">
                <li class="nav-item"><button class="nav-link active" type="button" data-action="target-scope" data-scope="group">{{#str}}groupview, availability_managed{{/str}}</button></li>
                <li class="nav-item"><button class="nav-link" type="button" data-action="target-scope" data-scope="user">{{#str}}userview, availability_managed{{/str}}</button></li>
            </ul>
            <label for="managed-target" class="form-label">{{#str}}selecttarget, availability_managed{{/str}}</label>
            <div class="d-flex gap-2">
                <select id="managed-target" class="form-select" data-action="target-select"></select>
                <button type="button" class="btn btn-primary" data-action="open-next" disabled>{{#str}}opennext, availability_managed{{/str}}</button>
            </div>
            <div class="mt-3" data-region="target-view"></div>
        </div>
    </div>
    <div class="mb-3">
        <label for="managed-content-search" class="form-label">{{#str}}searchcontent, availability_managed{{/str}}</label>
        <input id="managed-content-search" type="search" class="form-control" data-action="search">
    </div>
    {{#sections}}
        <section class="card mb-3" data-search-text="{{name}}">
            <div class="card-header d-flex justify-content-between align-items-center gap-3 flex-wrap">
                <div>
                    <strong>{{name}}</strong>
                    {{#hasmodules}}
                        <div class="small text-muted">{{#str}}sectioncontrolhint, availability_managed{{/str}}</div>
                    {{/hasmodules}}
                </div>
                <div class="btn-group" role="group">
                    <button type="button" class="btn btn-outline-primary btn-sm" data-action="edit"
                            data-itemtype="section" data-itemid="{{id}}" data-itemname="{{name}}"
                            aria-label="{{#str}}edititem, availability_managed, {{name}}{{/str}}">
                        <span data-region="summary">{{summary}}</span>
                    </button>
                    <button type="button" class="btn btn-outline-success btn-sm" data-action="quick-open"
                            data-itemtype="section" data-itemid="{{id}}"
                            title="{{#everyone}}{{#str}}alreadyopen_help, availability_managed{{/str}}{{/everyone}}{{^everyone}}{{#str}}openeveryone, availability_managed{{/str}}{{/everyone}}"
                            {{#everyone}}disabled aria-disabled="true"{{/everyone}}>
                        <span data-region="quick-label">{{#everyone}}✓ {{#str}}alreadyopen, availability_managed{{/str}}{{/everyone}}{{^everyone}}{{#str}}openeveryone, availability_managed{{/str}}{{/everyone}}</span>
                    </button>
                    <button type="button" class="btn btn-outline-danger btn-sm" data-action="quick-close"
                            data-itemtype="section" data-itemid="{{id}}"
                            title="{{#closed}}{{#str}}alreadyclosed_help, availability_managed{{/str}}{{/closed}}{{^closed}}{{#str}}closeeveryone, availability_managed{{/str}}{{/closed}}"
                            {{#closed}}disabled aria-disabled="true"{{/closed}}>
                        <span data-region="quick-label">{{#closed}}✓ {{#str}}alreadyclosed, availability_managed{{/str}}{{/closed}}{{^closed}}{{#str}}closeeveryone, availability_managed{{/str}}{{/closed}}</span>
                    </button>
                </div>
            </div>
            {{#hasmodules}}
                <div class="card-body py-2 text-muted{{^closed}} d-none{{/closed}}" data-region="section-closed-notice"
                     {{^closed}}hidden{{/closed}}>
                    <span>{{#str}}sectionclosedmodules, availability_managed{{/str}}</span>
                    <a class="ms-1" href="{{helpurl}}">{{#str}}whyhidden, availability_managed{{/str}}</a>
                </div>
            <div id="managed-modules-{{id}}" data-region="module-controls"
                 class="{{#closed}}d-none{{/closed}}" {{#closed}}hidden{{/closed}}>
                <div class="alert alert-info rounded-0 border-start-0 border-end-0 mb-0 py-2" role="note">
                    <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
                        <span>{{#str}}modulecontrolshelp, availability_managed{{/str}}</span>
                        <button type="button" class="btn btn-outline-secondary btn-sm" data-action="apply-children"
                                data-sectionid="{{id}}">
                            {{#str}}applychildren, availability_managed{{/str}}
                        </button>
                    </div>
                </div>
                <ul class="list-group list-group-flush">
                {{#modules}}
                    <li class="list-group-item d-flex justify-content-between align-items-center gap-3"
                        data-search-text="{{modname}} {{name}}">
                        <span><small class="text-muted">{{modname}}:</small> {{name}}</span>
                        <div class="btn-group" role="group">
                            <button type="button" class="btn btn-outline-secondary btn-sm" data-action="edit"
                                    data-itemtype="cm" data-itemid="{{id}}" data-itemname="{{name}}"
                                    aria-label="{{#str}}edititem, availability_managed, {{name}}{{/str}}">
                                <span data-region="summary">{{summary}}</span>
                            </button>
                            <button type="button" class="btn btn-outline-success btn-sm" data-action="quick-open"
                                    data-itemtype="cm" data-itemid="{{id}}"
                                    title="{{#everyone}}{{#str}}alreadyopen_help, availability_managed{{/str}}{{/everyone}}{{^everyone}}{{#str}}openeveryone, availability_managed{{/str}}{{/everyone}}"
                                    {{#everyone}}disabled aria-disabled="true"{{/everyone}}>
                                <span data-region="quick-label">{{#everyone}}✓ {{#str}}alreadyopen, availability_managed{{/str}}{{/everyone}}{{^everyone}}{{#str}}openaction, availability_managed{{/str}}{{/everyone}}</span>
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-sm" data-action="quick-close"
                                    data-itemtype="cm" data-itemid="{{id}}"
                                    title="{{#closed}}{{#str}}alreadyclosed_help, availability_managed{{/str}}{{/closed}}{{^closed}}{{#str}}closeeveryone, availability_managed{{/str}}{{/closed}}"
                                    {{#closed}}disabled aria-disabled="true"{{/closed}}>
                                <span data-region="quick-label">{{#closed}}✓ {{#str}}alreadyclosed, availability_managed{{/str}}{{/closed}}{{^closed}}{{#str}}close, availability_managed{{/str}}{{/closed}}</span>
                            </button>
                        </div>
                    </li>
                {{/modules}}
                </ul>
            </div>
            {{/hasmodules}}
        </section>
    {{/sections}}
</div>
