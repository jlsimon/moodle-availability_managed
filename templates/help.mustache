{{!
    @template availability_managed/help

    Contextual help for managed availability.

    Example context (json):
    {
        "dashboardurl": "https://example.invalid/managed"
    }
}}
<div class="local-managedavailability-help">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h2 class="mb-1">{{#str}}helptitle, availability_managed{{/str}}</h2>
            <p class="text-muted mb-0">{{#str}}helpintro, availability_managed{{/str}}</p>
        </div>
        <a href="{{dashboardurl}}" class="btn btn-primary">{{#str}}gotodashboard, availability_managed{{/str}}</a>
    </div>

    <div class="alert alert-info" role="note">
        <h3 class="h5">{{#str}}helpkeytitle, availability_managed{{/str}}</h3>
        <p class="mb-0">{{#str}}helpkeytext, availability_managed{{/str}}</p>
    </div>

    <div class="row">
        <div class="col-lg-6">
            <section class="card mb-3"><div class="card-body">
                <h3 class="h5">{{#str}}helpwhat_title, availability_managed{{/str}}</h3>
                <p>{{#str}}helpwhat_text, availability_managed{{/str}}</p>
                <ul class="mb-0">
                    <li>{{#str}}helpwhat_everyone, availability_managed{{/str}}</li>
                    <li>{{#str}}helpwhat_groups, availability_managed{{/str}}</li>
                    <li>{{#str}}helpwhat_users, availability_managed{{/str}}</li>
                    <li>{{#str}}helpwhat_closed, availability_managed{{/str}}</li>
                </ul>
            </div></section>

            <section class="card mb-3"><div class="card-body">
                <h3 class="h5">{{#str}}helpedit_title, availability_managed{{/str}}</h3>
                <ol class="mb-0">
                    <li>{{#str}}helpedit_step1, availability_managed{{/str}}</li>
                    <li>{{#str}}helpedit_step2, availability_managed{{/str}}</li>
                    <li>{{#str}}helpedit_step3, availability_managed{{/str}}</li>
                    <li>{{#str}}helpedit_step4, availability_managed{{/str}}</li>
                </ol>
            </div></section>
        </div>

        <div class="col-lg-6">
            <section class="card mb-3"><div class="card-body">
                <h3 class="h5">{{#str}}helpfast_title, availability_managed{{/str}}</h3>
                <dl class="mb-0">
                    <dt>{{#str}}openeveryone, availability_managed{{/str}}</dt>
                    <dd>{{#str}}helpfast_open, availability_managed{{/str}}</dd>
                    <dt>{{#str}}closeeveryone, availability_managed{{/str}}</dt>
                    <dd>{{#str}}helpfast_close, availability_managed{{/str}}</dd>
                    <dt>{{#str}}applychildren, availability_managed{{/str}}</dt>
                    <dd class="mb-0">{{#str}}helpfast_apply, availability_managed{{/str}}</dd>
                </dl>
            </div></section>

            <section class="card mb-3"><div class="card-body">
                <h3 class="h5">{{#str}}helpadvance_title, availability_managed{{/str}}</h3>
                <p>{{#str}}helpadvance_text, availability_managed{{/str}}</p>
                <ol class="mb-0">
                    <li>{{#str}}helpadvance_step1, availability_managed{{/str}}</li>
                    <li>{{#str}}helpadvance_step2, availability_managed{{/str}}</li>
                    <li>{{#str}}helpadvance_step3, availability_managed{{/str}}</li>
                </ol>
            </div></section>
        </div>
    </div>

    <section class="card border-warning mb-3"><div class="card-body">
        <h3 class="h5">{{#str}}helpcare_title, availability_managed{{/str}}</h3>
        <ul class="mb-0">
            <li>{{#str}}helpcare_other, availability_managed{{/str}}</li>
            <li>{{#str}}helpcare_section, availability_managed{{/str}}</li>
            <li>{{#str}}helpcare_groups, availability_managed{{/str}}</li>
            <li>{{#str}}helpcare_bulk, availability_managed{{/str}}</li>
        </ul>
    </div></section>

    <section class="card"><div class="card-body">
        <h3 class="h5">{{#str}}helpexamples_title, availability_managed{{/str}}</h3>
        <p><strong>{{#str}}helpexample_group_title, availability_managed{{/str}}</strong><br>
            {{#str}}helpexample_group_text, availability_managed{{/str}}</p>
        <p class="mb-0"><strong>{{#str}}helpexample_user_title, availability_managed{{/str}}</strong><br>
            {{#str}}helpexample_user_text, availability_managed{{/str}}</p>
    </div></section>
</div>
